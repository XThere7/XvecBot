# ── Secrets: never commit real keys ──────────────────────────────────────────
# Covers root .env, BaseBot_UI/.env, backend/.env (any depth).
# Template files (.env.example) are safe — the pattern below does NOT match them.
.env
.env.local
*.pem
*.key
*.p12
*.pfx

# Python generated files
__pycache__/
*.pyc
*.pyo

# ── Databases & runtime user data: never commit ─────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
backend/data/
uploads/
# ML model weights at project root only — NOT the Python package backend/app/models/
#/models/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/


ip-tmp/

# ── Node / frontend build ────────────────────────────────────────────────────
node_modules/
BaseBot_UI/.next/
frontendbot.md
PHASE2&3.MD
README.md
# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.env
.env

# Generated widget production build (run: python backend/scripts/build_widget.py)
backend/app/static/widget.min.js
data/rag.db