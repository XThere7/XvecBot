# ── Secrets: never commit real keys ──────────────────────────────────────────
# Covers root .env, BaseBot_UI/.env, backend/.env (any depth).
# Template files (.env.example) are safe — the pattern below does NOT match them.
.env
.env.local
*.pem
*.key
*.p12
*.pfx

# Python generated files
__pycache__/
*.pyc
*.pyo

# ── Databases & runtime user data: never commit ─────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
backend/data/
uploads/
# ML model weights at project root only — NOT the Python package backend/app/models/
#/models/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/


ip-tmp/

# ── Node / frontend build ────────────────────────────────────────────────────
node_modules/
BaseBot_UI/.next/
frontendbot.md
PHASE2&3.MD
phase2.md
phase3.md
phase4.md
phase5.md
multi-tenant.md
everything.txt
xdh.txt
README.md
# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Generated widget production build (run: python backend/scripts/build_widget.py)
backend/app/static/widget.min.js
data/rag.db

# Local hosting go-live plan (not part of the shipped repo)
go-live-hosting-plan.md

# All local documentation and notes stay on this machine, never in the repo.
*.md
*.txt
# ...except the files the build and the e2e fixtures need, plus the two
# operational documents the VPS itself needs (the runbook and the restore
# procedure). Drop these two lines if you want them local-only as well.
!requirements.txt
!BaseBot_UI/e2e/catalogue.txt
# Transactional-email plain-text parts are required at runtime.
!backend/app/emails/*.txt
!deploy/README.md
!deploy/restore.md
# ── Marketing video library (local only — never committed or deployed) ──────
marketing-videos/
botbase-hero-video/

# ── Local AI-agent tooling (never part of the product) ───────────────────────
agent/
.agents/
.claude/
skills-lock.json

# HuggingFace model cache (embedding + reranker weights)
.hf-cache/
