# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=production-rag
APP_VERSION=1.0.0
DEBUG=false

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/rag.db
VECTOR_DB_PATH=./data/embeddings/vectors.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# ── LLM (Ollama / llama-cpp) ──────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Explicit origins (regex in app/main.py additionally allows any 192.168.x.x / 10.x.x.x LAN host)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.27:5173,http://192.168.1.27:3000
