# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=production-rag
APP_VERSION=1.0.0
DEBUG=false

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/rag.db
VECTOR_DB_PATH=./data/embeddings/vectors.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# ── LLM (Ollama) ────────────────────────────────────────────────────────────
# qwen2.5 sizes are 0.5/1.5/3/7/14/32/72B — there is NO "35b" (that means 32B,
# which needs ~20 GB RAM and will OOM this 11 GB machine). Stay on 3B here,
# 7B max. `ollama list` shows what you have pulled.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Per-request timeout (s). 7B on CPU with RAG context needs minutes — 120 was too short.
OLLAMA_TIMEOUT=300
# Context window for Ollama (num_ctx). Smaller = less RAM + faster first token.
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── LLM (OpenVINO, Phase 2 — low-RAM local inference) ─────────────────────────
# To use: pip install -r backend/requirements-openvino.txt, then
#   python scripts/download_openvino_model.py
# then set LLM_PROVIDER=openvino. 3B INT4 ≈ 2 GB RAM, 7B INT4 ≈ 4–5 GB.
# Never point this at a 32B IR on this machine (~18 GB+ even as INT4).
# OPENVINO_MODEL_ID=./models/qwen2.5-3b-instruct-int4-ov
OPENVINO_MODEL_ID=OpenVINO/Qwen2.5-3B-Instruct-int4-ov
OPENVINO_DEVICE=CPU
OPENVINO_MAX_NEW_TOKENS=512

# ── CORS ──────────────────────────────────────────────────────────────────────
# Explicit origins (regex in app/main.py additionally allows any 192.168.x.x / 10.x.x.x LAN host)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.27:5173,http://192.168.1.27:3000
