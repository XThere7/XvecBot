# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=production-rag
APP_VERSION=1.0.0
DEBUG=false
# Public base URL of the API (used in widget snippets, emails, links).
# Examples: https://api.yourplatform.com (production) or http://localhost:8000.
APP_PUBLIC_URL=https://api.yourplatform.com
# Public base URL of the dashboard/hosted chat pages. This is where
# <base>/chat/<embed-token> resolves and is the origin auto-permitted for
# origin-restricted widget tokens (the hosted page's own browser Origin).
# It is NOT the API URL above. Set it to your dashboard origin, e.g.
# https://app.yourplatform.com or http://localhost:3000 locally.
HOSTED_BASE_URL=https://app.yourplatform.com
# Serve /docs + /redoc. Keep true locally; set false in production.
ENABLE_DOCS=false

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key-change-in-production
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`.
# The server REFUSES to boot with DEBUG=false and the default value.
SECRET_KEY=change-this-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default): SQLite file. Production (Neon): postgresql://…?sslmode=require
DATABASE_URL=sqlite:///./data/rag.db
# Neon pool tuning (only used for postgresql:// URLs).
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
# Legacy, unused (vectors live in the main DB). Kept for backward compat.
VECTOR_DB_PATH=./data/embeddings/vectors.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
# Object storage (R2/S3 presigned flow). Empty S3_BUCKET = local disk; use
# local disk only with a persistent upload volume. compose.prod.yml requires a
# bucket because its containers have no persistent app-data volume.
STORAGE_BACKEND=auto
S3_BUCKET=
S3_PREFIX=botbase
# R2 example: https://<accountid>.r2.cloudflarestorage.com (empty for AWS S3).
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESIGNED_PUT_EXPIRES=900
PRESIGNED_GET_EXPIRES=900
MAX_UPLOAD_BYTES=52428800

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# ── LLM (sole provider: OpenRouter cloud API) ────────────────────────────────
# Get a key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
# Automatic fallback when the primary model fails (rate limit, model
# unavailable, upstream 5xx, network error). Set empty to disable.
LLM_FALLBACK_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: your dashboard origin(s), comma-separated. The LAN regex in
# app/main.py is a dev convenience — set explicit origins in production.
ALLOWED_ORIGINS=https://app.yourplatform.com

# ── Runtime (compose / PaaS, not read by the app itself) ─────────────────────
# Backend workers in the production image. Default is 1 because the public and
# developer rate limiters are in-process and SQLite has a single writer. For
# Postgres horizontal scaling, put a shared limiter (gateway/WAF/Redis) in front
# before raising this, and verify DB write capacity.
UVICORN_WORKERS=1
# Abuse mitigation: scoped to /auth/* + /public/*, 60 req/min per IP.
# Off by default so local dev/tests are never throttled; prod enables it.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
# Log verbosity override (DEBUG/INFO/WARNING/ERROR). Empty = from DEBUG flag.
# Production JSON-to-stdout already; point your PaaS log drain at stdout.
LOG_LEVEL=
# Baked into the frontend image at build time (changing it needs a rebuild).
NEXT_PUBLIC_API_BASE_URL=https://api.yourplatform.com
NEXT_PUBLIC_APP_NAME=BotBase
# Canonical dashboard origin. Use a single origin (not a comma list) so the
# generated metadata URLs are valid.
NEXT_PUBLIC_SITE_URL=https://app.yourplatform.com

# ── Email (transactional: welcome email; password reset reuses this) ────────
# Backend: `file` writes .eml files to a git-ignored outbox (local dev +
# verification), `memory` keeps them in-process (tests only), `console` prints
# a header-only summary and refuses to run in production, `smtp` sends through
# the platform's real mailbox. The default is `file` so a fresh checkout can
# never send real mail by accident.
# EMAIL_BACKEND=
# EMAIL_OUTBOX_DIR=
# SMTP settings (only used when EMAIL_BACKEND=smtp). Missing credentials make
# the send fail gracefully — registration is never affected. Never commit the
# password; use a mailbox app password, not the account login password.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=          # starttls | ssl | none
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# EMAIL_REPLY_TO=
# Public product URLs used in the email copy. FRONTEND_URL is the dashboard
# origin and falls back to HOSTED_BASE_URL; DOCS_URL falls back to
# <frontend>/docs; SUPPORT_EMAIL falls back to EMAIL_REPLY_TO, then
# EMAIL_FROM_ADDRESS.
# FRONTEND_URL=
# DOCS_URL=
# SUPPORT_EMAIL=

# ── Password reset ───────────────────────────────────────────────────────────
# Single-use reset links expire after this many minutes (shared by the email
# copy, the validation endpoint and the token table).
# PASSWORD_RESET_TOKEN_TTL_MINUTES=
# Hourly per-email and per-IP request limits for POST /auth/forgot-password.
# In-process per worker (see the rate-limit note); use Redis when scaling out.
# PASSWORD_RESET_MAX_PER_EMAIL_PER_HOUR=
# PASSWORD_RESET_MAX_PER_IP_PER_HOUR=

# ── Admin panel ──────────────────────────────────────────────────────────────
# Admin sessions are shorter than ordinary user sessions (hours).
# ADMIN_SESSION_EXPIRE_HOURS=
# Admin sign-in attempts per email per 15 minutes.
# ADMIN_LOGIN_MAX_PER_EMAIL_PER_15M=
# TOTP verification attempts per account per 15 minutes.
# TOTP_MAX_ATTEMPTS_PER_15M=
# Admin set-password invite links expire after this many minutes.
# ADMIN_INVITE_TTL_MINUTES=
# usage_events rows older than this many days are purged at startup.
# USAGE_EVENTS_RETENTION_DAYS=

# ── Admin panel ──────────────────────────────────────────────────────────────
# The URL prefix of the admin panel. It must match the dashboard route
# (BaseBot_UI/src/app/bbx765adm) — changing one without the other breaks it.
# ADMIN_ROUTE_PREFIX=/bbx765adm

# ── Plans ────────────────────────────────────────────────────────────────────
# The plan a new workspace starts on. "free" in production; the 21-day trial
# is an effective access state on top of it, not a stored plan.
# DEFAULT_WORKSPACE_PLAN=free

# ── TLS ──────────────────────────────────────────────────────────────────────
# The address Let's Encrypt uses for expiry warnings (Caddy).
# ACME_EMAIL=
