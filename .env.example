# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=production-rag
APP_VERSION=1.0.0
DEBUG=false
# Public base URL of the API (used in widget snippets, emails, links).
APP_PUBLIC_URL=https://api.yourplatform.com
# Serve /docs + /redoc. Keep true locally; set false in production.
ENABLE_DOCS=false

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=your-secret-api-key-change-in-production
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`.
# The server REFUSES to boot with DEBUG=false and the default value.
SECRET_KEY=change-this-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (default): SQLite file. Production (Neon): postgresql://…?sslmode=require
DATABASE_URL=sqlite:///./data/rag.db
# Neon pool tuning (only used for postgresql:// URLs).
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
# Legacy, unused (vectors live in the main DB). Kept for backward compat.
VECTOR_DB_PATH=./data/embeddings/vectors.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
# Object storage (R2/S3 presigned flow). Empty S3_BUCKET = local disk.
STORAGE_BACKEND=auto
S3_BUCKET=
S3_PREFIX=xvecbot
# R2 example: https://<accountid>.r2.cloudflarestorage.com (empty for AWS S3).
S3_ENDPOINT_URL=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRESIGNED_PUT_EXPIRES=900
PRESIGNED_GET_EXPIRES=900
MAX_UPLOAD_BYTES=52428800

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# ── LLM (sole provider: OpenRouter cloud API) ────────────────────────────────
# Get a key at https://openrouter.ai/keys and paste it below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
# Automatic fallback when the primary model fails (rate limit, model
# unavailable, upstream 5xx, network error). Set empty to disable.
LLM_FALLBACK_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Production: your dashboard origin(s), comma-separated. The LAN regex in
# app/main.py is a dev convenience — set explicit origins in production.
ALLOWED_ORIGINS=https://app.yourplatform.com

# ── Runtime (compose / PaaS, not read by the app itself) ─────────────────────
# Backend workers in the production image (single worker + --reload for dev).
UVICORN_WORKERS=2
# Baked into the frontend image at build time (changing it needs a rebuild).
NEXT_PUBLIC_API_BASE_URL=https://api.yourplatform.com
NEXT_PUBLIC_APP_NAME=XvecBot
NEXT_PUBLIC_SITE_URL=https://app.yourplatform.com
