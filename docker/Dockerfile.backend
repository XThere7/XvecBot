FROM python:3.11-slim

WORKDIR /app

# Never bake secrets: configuration arrives as environment variables
# (PaaS dashboard) or a runtime-mounted .env — NOT via COPY into the image.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System deps for PyMuPDF and sqlite-vec, plus the Postgres client so the
# container can run pg_dump for the nightly off-site backup.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmupdf-dev gcc curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install CPU-only torch first to avoid pulling ~3GB of CUDA wheels
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
# Operational scripts (backup/restore/preflight) run inside the container.
COPY scripts/ ./scripts/

# HuggingFace/transformers cache (embedding + reranker weights). The build
# warms both models below; at runtime set HF_HOME to a persistent volume when
# the cache must survive restarts. Build args keep the warm-up in sync with
# custom model choices.
ARG EMBEDDING_MODEL=all-MiniLM-L6-v2
ARG RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENV HF_HOME=/app/.hf-cache \
    TRANSFORMERS_CACHE=/app/.hf-cache \
    HF_HUB_CACHE=/app/.hf-cache \
    EMBEDDING_MODEL=${EMBEDDING_MODEL} \
    RERANKER_MODEL=${RERANKER_MODEL}

# Create data directories (local-disk fallback; production uses Neon + R2)
# and make them writable for the runtime user (see USER below). The dev
# compose additionally maps `user: ${UID}:${GID}` so bind-mounted host
# files keep owner identity instead of becoming root-owned (which once
# zeroed a developer's data/rag.db).
RUN mkdir -p data/uploads data/processed data/embeddings .hf-cache \
 && chmod 755 data data/uploads data/processed data/embeddings

# Warm BOTH models. The reranker is loaded lazily on the first query in the
# application; without this, the first production request can block on a
# multi-hundred-MB download and time out. Keep this as a single RUN line so it
# works with both classic and BuildKit Dockerfile parsers.
#
# WARM_MODELS=0 skips the warm-up for local/CI builds that mount a pre-populated
# model cache instead (saves several hundred MB of download and RAM per build).
ARG WARM_MODELS=1
RUN if [ "$WARM_MODELS" = "1" ]; then \
      python -c "import os; from sentence_transformers import CrossEncoder, SentenceTransformer; SentenceTransformer(os.environ['EMBEDDING_MODEL']); CrossEncoder(os.environ['RERANKER_MODEL'])"; \
    fi

# Run as a non-root user in production. Site-packages stay root-owned
# (world-readable — imports work); only /app runtime dirs need ownership.
# Dev compose overrides with `user: ${UID}:${GID}` for bind-mount identity.
RUN useradd -m -u 1000 appuser \
 && chown -R appuser:appuser /app/data /app/.hf-cache
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health/ready || exit 1

# One worker is the safe default: the per-token/per-key rate limiters are
# in-process, and SQLite has a single writer. For Postgres deployments that
# need more concurrency, run multiple workers only behind a shared limiter
# (gateway/WAF/Redis) and verify write capacity first. The dev compose
# overrides the command with --reload --workers 1.
#
# --proxy-headers makes uvicorn trust X-Forwarded-For from the reverse proxy
# in front of the container, so the per-IP rate limiter sees the real client
# instead of the proxy's IP. Only safe because the app port is NOT published
# to the host (the compose file exposes it to the internal network only).
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-1} --proxy-headers --forwarded-allow-ips='*'"]
