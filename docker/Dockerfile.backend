FROM python:3.11-slim

WORKDIR /app

# Never bake secrets: configuration arrives as environment variables
# (PaaS dashboard) or a runtime-mounted .env — NOT via COPY into the image.

# System deps for PyMuPDF and sqlite-vec
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmupdf-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install CPU-only torch first to avoid pulling ~3GB of CUDA wheels
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

# HuggingFace/transformers cache (embedding + reranker weights). Build-time
# download below warms it; at runtime set HF_HOME to a persistent volume
# when the cache must survive restarts.
ENV HF_HOME=/app/.hf-cache \
    TRANSFORMERS_CACHE=/app/.hf-cache \
    HF_HUB_CACHE=/app/.hf-cache

# Create data directories (local-disk fallback; production uses Neon + R2)
# and make them writable for the runtime user (see USER below). The dev
# compose additionally maps `user: ${UID}:${GID}` so bind-mounted host
# files keep owner identity instead of becoming root-owned (which once
# zeroed a developer's data/rag.db).
RUN mkdir -p data/uploads data/processed data/embeddings .hf-cache \
 && chmod -R a+rwX data .hf-cache

# Download embedding model at build time so startup is instant
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Run as a non-root user in production. Site-packages stay root-owned
# (world-readable — imports work); only /app runtime dirs need ownership.
# Dev compose overrides with `user: ${UID}:${GID}` for bind-mount identity.
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app/data /app/.hf-cache
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s \
    CMD curl -f http://localhost:8000/health/ready || exit 1

# Workers scale with CPU in production (UVICORN_WORKERS=2 default);
# local dev overrides the command with --reload --workers 1.
CMD ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
