# BotBase API — TLS termination (Caddy).
#
# The hostnames come from the API_DOMAIN and API_ALT_DOMAIN environment
# variables that docker/compose.prod.yml passes in. Both serve the same API;
# the alternate hostname lets the frontend switch immediately when a DNS
# record is replaced and old resolvers still hold the previous TTL.
#
# Cloudflare note (important):
#   When the DNS record is proxied (orange cloud), the peer is a Cloudflare
#   edge IP. Caddy forwards CF-Connecting-IP as X-Forwarded-For so the API's
#   per-IP rate limiter still buckets by the real client, not the edge.
#
# The API itself is not published to the host: only this container exposes
# 80/443, so nobody can bypass TLS or the proxy.

{
	email {$ACME_EMAIL:botbase-admin@example.com}
	# Uncomment to use Cloudflare's DNS-01 challenge instead of HTTP-01:
	# (needs a Cloudflare API token in the environment)
	# acme_dns cloudflare {env.CF_API_TOKEN}
}

{$API_DOMAIN}, {$API_ALT_DOMAIN} {
	encode zstd gzip

	header {
		# Caddy adds these by default; the API sets its own CORS headers.
		-Server
	}

	reverse_proxy backend:8000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}

	log {
		output stdout
		format json
	}
}
