# BotBase production environment — copy to /opt/botbase/.env on the VPS and
# fill in every value. `chmod 600 /opt/botbase/.env` (secrets!).
#
#   cp deploy/env.example /opt/botbase/.env
#   nano /opt/botbase/.env
#   docker compose --env-file /opt/botbase/.env -f docker/compose.prod.yml up -d --build
#
# The compose file reads this file; it never bakes it into an image.

# ── Hostnames ───────────────────────────────────────────────────────────────
# The API hostname (DNS points here, Caddy serves TLS for it).
API_DOMAIN=api.yourdomain.com
API_ALT_DOMAIN=api-v2.yourdomain.com
# The dashboard origin. With Vercel this is the Vercel custom domain.
# It must be a single origin, not a list.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# The API origin. Used to build widget snippets and absolute URLs.
APP_PUBLIC_URL=https://api.yourdomain.com
# The dashboard origin that serves /chat/<token>. It is also the origin that
# is automatically allowed for origin-restricted widget tokens.
HOSTED_BASE_URL=https://www.yourdomain.com
# Comma-separated dashboard origins allowed to call the API with a JWT.
ALLOWED_ORIGINS=https://www.yourdomain.com
# The address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=ops@yourdomain.com
# Public URLs used inside transactional email. FRONTEND_URL is the dashboard
# origin (the sign-in button in a reset mail points here).
FRONTEND_URL=https://www.yourdomain.com
DOCS_URL=https://www.yourdomain.com/docs
# The mailbox customers are told to reply to. It must be a real inbox.
SUPPORT_EMAIL=support@yourdomain.com

# ── Secrets (generate: python3 -c "import secrets;print(secrets.token_hex(32))") ─
SECRET_KEY=
API_KEY=
# Optional: OpenRouter key (a free model needs the key but costs nothing).
OPENROUTER_API_KEY=
# The model used for answers. openrouter/free auto-routes to an available
# free model; pin a specific model id if you prefer. An invalid id returns
# 404 and falls through to LLM_FALLBACK_MODEL (chat still works, logs an error).
OPENROUTER_MODEL=openrouter/free
LLM_FALLBACK_MODEL=openrouter/free

# ── Database (self-hosted Postgres in the compose stack) ─────────────────────
# The password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://botbase:CHANGE_ME@db:5432/botbase
POSTGRES_USER=botbase
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=botbase
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10

# ── Object storage (Cloudflare R2 — required: the container disk is ephemeral) ─
STORAGE_BACKEND=auto
S3_BUCKET=botbase-prod
S3_PREFIX=botbase
# R2: https://<account-id>.r2.cloudflarestorage.com  (empty for AWS S3)
S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=52428800

# ── Transactional email (welcome + password reset) ──────────────────────────
# file | memory | smtp | console. In production this MUST be smtp — with
# "file" the reset mail is written into the container and never delivered.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
# Resend uses "resend" as the username and the API key as the password.
SMTP_USERNAME=resend
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
# The From address must be a verified sender domain (SPF/DKIM must match).
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
EMAIL_FROM_NAME=BotBase
# Where replies go — a mailbox you actually read.
EMAIL_REPLY_TO=support@yourdomain.com
# Password reset links are single-use and expire after this many minutes.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_EMAIL_PER_HOUR=5
PASSWORD_RESET_MAX_PER_IP_PER_HOUR=20

# ── Admin panel ─────────────────────────────────────────────────────────────
# The URL prefix of the admin panel. It must match the dashboard route
# (BaseBot_UI/src/app/bbx765adm) — changing one without the other breaks it.
ADMIN_ROUTE_PREFIX=/bbx765adm
ADMIN_SESSION_EXPIRE_HOURS=8
# usage_events rows older than this are purged at startup.
USAGE_EVENTS_RETENTION_DAYS=90

# ── Plans ───────────────────────────────────────────────────────────────────
# The plan new workspaces start on. "free" in production; the 21-day trial
# is an effective access state on top of it, not a stored plan.
DEFAULT_WORKSPACE_PLAN=free

# ── Runtime ─────────────────────────────────────────────────────────────────
DEBUG=false
ENABLE_DOCS=false
LOG_LEVEL=INFO
# One worker: the rate limiters are in-process. Raise only behind a shared
# limiter (Cloudflare rules / Redis) and after load-testing writes.
UVICORN_WORKERS=1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# Legacy global API (/api/v1/query, /api/v1/documents) uses one API_KEY and is
# not workspace-scoped. Keep false on a public multi-tenant deployment.
ENABLE_LEGACY_API=false
# Set to 0 to skip baking the models into the image (they are then cached in
# the hf-cache volume on first boot).
WARM_MODELS=1
NEXT_PUBLIC_APP_NAME=BotBase
